msgstr "Zeitzonenkonfiguration"

#: cui/classes/application.py:443
msgid "Timezone"
msgstr "Zeitzone"

#: cui/classes/application.py:444
msgid "Opens a dialog for selecting the system timezone via timedatectl."
msgstr "Öffnet einen Dialog zur Auswahl der Systemzeitzone über timedatectl."

#: cui/classes/application.py:446 cui/classes/model.py:347
msgid "timesyncd configuration"
msgstr "Zeitsynchronisationskonfiguration"

#: cui/classes/application.py:447
msgid "timesyncd"
msgstr "Zeitsynchronisationsdienst"

#: cui/classes/application.py:448
msgid ""
"Opens a simple configurator for configuring systemd-timesyncd as a "
"lightweight NTP client for time synchronization."
msgstr ""
"Öffnet einen einfachen Konfigurator um systemd-timesyncd als lightweight NTP "
"client zur Zeitsynchronisation einzurichten."

#: cui/classes/application.py:451
msgid "Select software repositories"
msgstr "Software Repositories auswählen"

#: cui/classes/application.py:452
msgid "Software repositories selection"
msgstr "Software Repositories Auswahl"

#: cui/classes/application.py:453
msgid "Opens dialog for choosing software repositories."
msgstr "Öffnet einen Dialog zum Auswählen des Software Repositories."

