msgid "Update the system"
msgstr "Aktualisiere das System"

#: cui/classes/application.py:456 cui/classes/handler.py:685
msgid "System update"
msgstr "Systemupdate"

#: cui/classes/application.py:457
msgid ""
"Executes the system package manager for the installation of newer component "
"versions."
msgstr ""
"Führt den System-Paket-Manager zur Installation neuer Komponentenversionen "
"aus."

#: cui/classes/application.py:460
msgid "grommunio setup wizard"
msgstr "grommunio Setup Assistent"

#: cui/classes/application.py:461 cui/classes/model.py:495
